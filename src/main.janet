(import ../lib/portable-agents/protocol :as p)
(import ../lib/portable-agents/markdown)
(import spork/sh :as sh)
(import spork/path :as path)
(import portable-agents/host :as host)

(defn- sinks []
  (def writes (ev/thread-chan 1))
  (def ready (ev/thread-chan 1))
  (ev/thread (fn [writes]
    (def output (host/protocol-output))
    (ev/give-supervisor :ready true)
    (var observing true)
    (var packet nil)
    (while (set packet (ev/take writes))
      (def [bytes reply] packet)
      (when observing
        (try (do (file/write output bytes) (file/flush output)) ([err] (set observing false))))
      (ev/give reply observing))) writes :n ready)
  (def [status value] (ev/take ready))
  (assert (= status :ready) value)
  (var logging true)
  (defn publish [frame]
    (def reply (ev/thread-chan 1))
    (ev/give writes [(string (p/json frame) "\n") reply])
    (ev/take reply))
  [publish
   (fn [bytes] (publish {"version" p/version "type" "stdout" "output" (p/base64 bytes)}))
   (fn [bytes] (when logging (try (do (file/write stderr bytes) (file/flush stderr)) ([err] (set logging false)))))])

(defn main [executable operation & args]
  (assert (and (= operation "run") (= 2 (length args))) "usage: agent run FRAME-BYTES ADMISSION-SECONDS")
  (def limits (table ;(interleave ["frameBytes" "admissionSeconds"] (map scan-number args))))
  (assert (and (int? (limits "frameBytes")) (<= 1 (limits "frameBytes") 0x7fffffff)
               (number? (limits "admissionSeconds")) (< 0 (limits "admissionSeconds") math/inf)) "InvalidLimits")
  (unless (index-of (os/which) [:windows :mingw]) (os/sigaction :pipe (fn [])))
  (host/detach)
  (markdown/register)
  (def [publish out log] (sinks))
  (when-let [library (os/getenv "JANET_PATH")] (module/add-syspath library))
  (with-dyns [:pa/limits limits]
    (def ready (ev/thread-chan 1))
    (def admitted (ev/thread-chan 1))
    (ev/thread (fn [[deadline ready]]
                 (try (do (ev/with-deadline (max 0 (- deadline (os/clock :monotonic))) (ev/take ready))
                          (assert (< (os/clock :monotonic) deadline) "AdmissionTimeout"))
                   ([err] (os/exit 1 true))))
               [(+ (os/clock :monotonic) (limits "admissionSeconds")) ready] :n admitted)
    (try
      (do
        (def [env target input config] (do
          (def reader (p/reader stdin))
          (def request (p/request (p/receive reader)))
          (assert (not (p/receive reader)) "InvalidProtocol")
          (def program (request "program"))
          (put program "sourceDir" (os/realpath (program "sourceDir")))
          (def base (make-env))
          (put base :pa/executable (if (= executable (path/basename executable)) (sh/self-exe) (os/realpath executable)))
          (put base :pa/limits limits)
          (put base :pa/program program)
          (put base *syspath* (program "sourceDir"))
          (each [name root] (pairs (get program "dependencies" {}))
            (def root (os/realpath root))
            (put (program "dependencies") name root)
            (put base (keyword name) root))
          (def imports (get program "imports" {}))
          (def cache (merge module/cache))
          (each [name module] (pairs imports) (put cache name (p/import-module module)))
          (def paths (array/concat @[] module/paths))
          (array/insert paths 0 [(fn [name] (when (has-key? imports name) name)) :preload])
          (put base *module-cache* cache)
          (put base *module-paths* paths)
          (put base :out out)
          (put base :err log)
          (put base *module-make-env* (partial make-env base))
          (with-env base
            (def env (require (string (base *syspath*) "/" (program "entryModule"))))
            (def name (symbol (program "entry")))
            (assert (and (has-key? env name) (not ((env name) :private)) (not ((env name) :macro))) "UnknownEntry")
            (def target (module/value env name))
            (assert (index-of (type target) [:function :cfunction]) "NotCallable")
            [env target (p/base64 (request "input") true) (p/base64 (request "config") true)])))
        (publish {"version" p/version "type" "ready"})
        (ev/give ready true)
        (assert (= :ok ((ev/take admitted) 0)) "AdmissionWatcherFailed")
        (def supervisor (ev/chan 1))
        (def task (ev/go (fn [] (with-env env (target input config))) nil supervisor))
        (var result nil) (var returned false)
        (while (or (not returned) (> (length (ev/all-tasks)) 1) (> (ev/count supervisor) 0))
          (if (= 0 (ev/count supervisor))
            (ev/sleep 0.01)
            (let [[status fiber] (ev/take supervisor)]
              (when (= status :error) (propagate (fiber/last-value fiber) fiber))
              (when (and (= status :ok) (= fiber task))
                (set result (fiber/last-value fiber))
                (set returned true)))))
        (publish {"version" p/version "type" "result" "output" (p/base64 result)}))
      ([err fiber] (publish (p/failure err fiber)))))
  (os/exit 0 true))
