(import ../src/pa)
(import ../src/protocol :as p)
(def limits {"frameBytes" 1048576 "depth" 32 "inFlight" 8 "handles" 64 "admissionSeconds" 5})
(with-dyns [:pa/limits limits]
  (each text ["{}" "[1,true,null,\"😀\"]" "{\"a\":\"\\uD83D\\uDE00\"}"] (p/json text true))
  (each text ["{\"a\":1,\"a\":2}" "{\"a\":NaN}" "{\"a\":\"\\uD800\"}" "{}x" "\xff"]
    (assert (try (do (p/json text true) false) ([err] true))))
  (each text ["A" "Zh==" "Zm9=" "Zg==\n"] (assert (try (do (p/base64 text true) false) ([err] true))))
  (def bytes (string (os/cryptorand 256)))
  (assert (= bytes (p/base64 (p/base64 bytes) true)))
  (def program {"sourceDir" (let [file (os/realpath (dyn :current-file))] (string/slice file 0 (- (length file) (length "protocol.janet")))) "entryModule" "program"})
  (def options {:limits limits :spawn ["janet"] :sink (fn [event] (assert (= "append" (event "type"))))})
  (assert (= bytes (pa/invoke program bytes "" options)))
  (def started (os/clock :monotonic))
  (assert (= bytes (pa/invoke program bytes "" (merge options {:member "spawn-test" :sink (fn [&] nil)}))))
  (assert (< (- (os/clock :monotonic) started) 1.5) "ignored child delayed caller completion")
  (def child (pa/spawn program bytes "" (merge options {:member "pause"})))
  (assert (= bytes (pa/await child)))
  (assert (= bytes (pa/await child)))
  (print "PASS strict JSON/Unicode/Base64, opaque bytes, append, ignored child, independent completion and repeated awaits"))
